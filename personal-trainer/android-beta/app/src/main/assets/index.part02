mstrings'},{n:'Standing Calf Raise',cat:'Rehab',slug:null,sets:3,reps:15,kg:0,rest:60,m:'Calf • Achilles capacity'},{n:'Spanish Squat',cat:'Rehab',slug:'squat',sets:3,reps:12,kg:0,rest:60,m:'Quadriceps • knee capacity'},{n:'Wrist Extensor Isometric',cat:'Upper',slug:null,sets:4,reps:30,kg:0,rest:45,m:'Forearm extensor tendon'},{n:'Hip Mobility Flow',cat:'Mobility',slug:'leg-swings-stretch',sets:2,reps:10,kg:0,rest:30,m:'Hip mobility'}];let frameTimer=null,frameIx=0,workoutTimer=null,secs=0,setDone=0,paused=false;
function frameUrls(ex){if(!ex.slug)return[];return[1,2,3].map(i=>`https://cdn.jsdelivr.net/npm/@bryllim/workout-guide@1.0.0/assets/${ex.slug}/frame-${i}.svg`)}function cycle(ids,ex){clearInterval(frameTimer);const imgs=ids.map($),urls=frameUrls(ex);imgs.forEach((im,i)=>{im.classList.remove('show');im.removeAttribute('src');if(urls[i])im.src=urls[i]});if(!urls.length)return;frameIx=0;imgs[0].classList.add('show');frameTimer=setInterval(()=>{imgs.forEach(x=>x.classList.remove('show'));frameIx=(frameIx+1)%3;imgs[frameIx].classList.add('show')},2000)}
function render(){const ex=EX[S.ex];$('hello').textContent=S.name?`Good Morning, ${S.name}`:"Good Morning. Let's Train.";$('drawerName').textContent=S.name||'Your Name';$('readyScore').textContent=S.readiness+'/10';$('readyText').textContent=S.readiness>=7?'Good to train':S.readiness>=4?'Reduce load':'Recovery day';$('readyText').style.color=S.readiness>=7?'var(--green)':S.readiness>=4?'#ffd34d':'var(--red)';$('injuryFocus').textContent=(S.injury||'Recovery')+' Capacity';const w=S.workouts.filter(x=>Date.now()-x.date<7*864e5).length;$('weekProgress').textContent=w+'/'+S.days;$('weekBar').style.width=Math.min(100,w/S.days*100)+'%';$('exCount').textContent=`EXERCISE ${S.ex+1} OF ${EX.length}`;$('exName').textContent=ex.n;$('sets').textContent=ex.sets;$('reps').textContent=ex.reps;$('weight').textContent=ex.kg||'BW';$('rest').textContent=ex.rest+'s';$('motionNote').textContent=ex.slug?'3-pose anatomical sequence • Start → Mid → End • 6 sec loop':'Motion hidden until a reviewed 3-pose asset is available';cycle(['frame1','frame2','frame3'],ex);['calories','protein','water','creatine'].forEach(k=>$(k+'Val').textContent=S.nut[k]+' / '+({calories:2250,protein:140,water:2500,creatine:5}[k]));$('foodSummary').textContent=[S.allergies&&'Allergies: '+S.allergies,S.foodAvoid&&'Avoid: '+S.foodAvoid].filter(Boolean).join(' • ')||'None set';$('autoPlay').checked=S.autoPlay;$('autoStop').checked=S.autoStop;renderList()}
function showPage(p){$$('.page').forEach(x=>x.classList.toggle('active',x.dataset.page===p));$$('[data-nav]').forEach(x=>x.classList.toggle('active',x.dataset.nav===p));closeDrawer();scrollTo(0,0)}function openDrawer(){$('drawer').classList.add('open');$('scrim').classList.add('show')}function closeDrawer(){$('drawer').classList.remove('open');$('scrim').classList.remove('show')}function modal(title,eye,html){$('modalTitle').textContent=title;$('modalEye').textContent=eye;$('modalBody').innerHTML=html;$('modal').classList.remove('hidden');closeDrawer();bindModal()}function closeModal(){$('modal').classList.add('hidden')}
function showModal(k){if(k==='goals')modal('Set Your Goal','GOALS',`<div class="choice">${['General Fitness','Injury Focused','5K','10K','Half Marathon','Full Marathon'].map(g=>`<button class="goalChoice ${S.goal===g?'selected':''}" data-v="${g}">${g}</button>`).join('')}</div><label class="field">Target time<input id="targetF" value="${S.target}"></label><label class="field">Weeks <b id="weeksOut">${S.weeks}</b><input id="weeksF" type="range" min="4" max="52" value="${S.weeks}"></label><label class="field">Days/week <b id="daysOut">${S.days}</b><input id="daysF" type="range" min="2" max="7" value="${S.days}"></label><button id="saveGoal" class="primary">SAVE GOAL</button>`);else if(k==='programs')modal('Training Programs','PROGRAMS',`<div class="list"><button data-weeks="12"><b>3 Month Program</b><small>Build a solid foundation</small></button><button data-weeks="26"><b>6 Month Program</b><small>Increase endurance</small></button><button data-weeks="52"><b>12 Month Program</b><small>Peak performance</small></button><button data-goalset="5K"><b>5K Program</b><small>Race specific</small></button><button data-goalset="10K"><b>10K Program</b><small>Race specific</small></button><button data-goalset="Half Marathon"><b>Half Marathon Program</b><small>Race specific</small></button><button data-goalset="Full Marathon"><b>Full Marathon Program</b><small>Race specific</small></button></div>`);else if(k==='injuries')modal('Injuries','RECOVERY',`<div class="choice">${['Knee','Achilles','Tennis Elbow','Lower Back','Hip','Shoulder','Custom'].map(x=>`<button class="injChoice ${S.injury===x?'selected':''}" data-v="${x}">${x}</button>`).join('')}</div><label class="field">Side<select id="sideF"><option>Left</option><option>Right</option><option>Both</option></select></label><label class="field">Pain level <b id="painOut">${S.pain}/10</b><input id="painF" type="range" min="0" max="10" value="${S.pain}"></label><label class="field">Restrictions / notes<textarea id="notesF">${S.notes||''}</textarea></label><button id="saveInjury" class="primary">SAVE</button>`);else if(k==='food')modal('Food & Allergies','NUTRITION',`<label class="field">Food allergies<textarea id="allergyF">${S.allergies||''}</textarea></label><label class="field">Foods to avoid<textarea id="avoidF">${S.foodAvoid||''}</textarea></label><button id="saveFood" class="primary">SAVE</button>`);else if(k==='connected')modal('Connected Data','SYNC',`<div class="card"><b>Garmin</b><div class="muted">Automatic account sync requires Garmin API authorization. Beta supports activity-file import.</div><input id="garminImport" type="file" accept=".gpx,.tcx,.csv"></div><div class="card"><b>Strava</b><div class="muted">Automatic OAuth requires app credentials. Beta supports exported file import.</div><input id="stravaImport" type="file" accept=".gpx,.tcx,.csv"></div>`);else if(k==='progress'){const n=S.workouts.length;modal('Your Progress','PROGRESS',`<div class="card"><span class="eyebrow">WORKOUTS COMPLETED</span><div class="big">${n}</div></div><div class="card"><span class="eyebrow">CURRENT GOAL</span><div class="big">${S.goal}</div><div class="muted">Target ${S.target}</div></div><div class="card"><span class="eyebrow">PAIN TREND</span><div class="big">${S.pain}/10</div><div class="muted">Current ${S.injury}</div></div>`)}else if(k==='settings')modal('Settings','APP',`<label class="field">Name<input id="nameF" value="${S.name||''}"></label><button id="saveSettings" class="primary">SAVE PROFILE</button><button id="backup" class="secondary" style="width:100%;margin-top:10px">EXPORT BACKUP</button><input id="restore" type="file" accept="application/json" style="margin-top:14px">`);else if(k==='admin')modal('Admin Panel','ADMIN',`<div class="card"><b>Admin controls</b><div class="muted">Edit profile, program defaults and reset local beta data.</div></div><label class="field">Admin PIN<input id="pinF" type="password" placeholder="1234"></label><button id="unlockAdmin" class="primary">UNLOCK</button><div id="adminTools" class="hidden"><label class="field">Default training days<input id="adminDays" type="number" min="2" max="7" value="${S.days}"></label><button id="adminSave" class="primary">SAVE DEFAULTS</button><button id="reset" class="primary danger">RESET ALL BETA DATA</button></div>`);}
function bindModal(){const q=s=>$('modalBody').querySelector(s);$$('.goalChoice').forEach(b=>b.onclick=()=>{S.goal=b.dataset.v;$$('.goalChoice').forEach(x=>x.classList.remove('selected'));b.classList.add('selected')});if(q('#weeksF'))q('#weeksF').oninput=e=>q('#weeksOut').textContent=e.target.value;if(q('#daysF'))q('#daysF').oninput=e=>q('#daysOut').textContent=e.target.value;if(q('#saveGoal'))q('#saveGoal').onclick=()=>{S.target=q('#targetF').value;S.weeks=+q('#weeksF').value;S.days=+q('#daysF').value;save();closeModal();toast('Goal saved')};$$('[data-weeks]').forEach(b=>b.onclick=()=>{S.weeks=+b.dataset.weeks;save();toast('Program selected');closeModal()});$$('[data-goalset]').forEach(b=>b.onclick=()=>{S.goal=b.dataset.goalset;save();toast('Race program selected');closeModal()});$$('.injChoice').forEach(b=>b.onclick=()=>{S.injury=b.dataset.v;$$('.injChoice').forEach(x=>x.classList.remove('selected'));b.classList.add('selected')});if(q('#sideF'))q('#sideF').value=S.side;if(q('#painF'))q('#painF').oninput=e=>q('#painOut').textContent=e.target.value+'/10';if(q('#saveInjury'))q('#saveInjury').onclick=()=>{S.side=q('#sideF').value;S.pain=+q('#painF').value;S.notes=q('#notesF').value;save();closeModal();toast('Injury profile saved')};if(q('#saveFood'))q('#saveFood').onclick=()=>{S.allergies=q('#allergyF').value;S.foodAvoid=q('#avoidF').value;save();closeModal();toast('Food profile saved')};if(q('#saveSettings'))q('#saveSettings').onclick=()=>{S.name=q('#nameF').value;save();closeModal();toast('Profile saved')};if(q('#backup'))q('#b