tein:0,water:0,creatine:0},autoPlay:true,autoStop:true,musicDuringRest:true,ex:0,filter:'All',session:'TRAIN',selectedDay:new Date().toISOString().slice(0,10),imports:{garmin:null,strava:null},adminPin:'1234'};
function deepMerge(a,b){const out={...a,...b};out.nut={...a.nut,...(b&&b.nut||{})};out.readiness={...a.readiness,...(b&&b.readiness||{})};out.imports={...a.imports,...(b&&b.imports||{})};return out}
function storageGet(){try{return localStorage.getItem(KEY)||'{}'}catch(e){return '{}'}}function storageSet(v){try{localStorage.setItem(KEY,v)}catch(e){window.__memStore=v}}function storageRemove(){try{localStorage.removeItem(KEY)}catch(e){window.__memStore=null}}
const $=id=>document.getElementById(id),$$=s=>[...document.querySelectorAll(s)];let S;try{S=deepMerge(defaults,JSON.parse(storageGet()))}catch(e){S=deepMerge(defaults,{})}let workoutTimer=null,restTimer=null,secs=0,setDone=0,paused=false,restLeft=0;const EX=[
{n:'Goblet Squat',cat:'Lower',media:'goblet',review:'STATIC_APPROVED',sets:3,reps:12,kg:16,rest:60,m:'Quads • Glutes • Core',cue:'Chest tall • knees track with toes • control the descent',errors:'Knees collapsing inward • chest dropping • heels lifting',alts:'Leg Press • Spanish Squat'},
{n:'45° Leg Press',cat:'Lower',media:'legpress',review:'STATIC_APPROVED',sets:3,reps:12,kg:70,rest:90,m:'Quads • Glutes • Hamstrings',cue:'Back and pelvis supported • feet flat • stop short of knee lockout',errors:'Pelvis lifting • knees collapsing inward • locking knees',alts:'Goblet Squat • Hack Squat'},
{n:'Standing Calf Raise',cat:'Rehab',media:null,review:'PENDING',sets:3,reps:15,kg:0,rest:60,m:'Calf • Achilles capacity',cue:'Slow rise • pause at top • controlled lowering',errors:'Bouncing • rolling ankle outward',alts:'Seated Calf Raise'},
{n:'Spanish Squat',cat:'Rehab',media:null,review:'PENDING',sets:3,reps:12,kg:0,rest:60,m:'Quadriceps • Knee capacity',cue:'Sit back into strap • torso tall • control depth',errors:'Painful depth • knee collapse',alts:'Leg Press • Isometric Wall Sit'},
{n:'Wrist Extensor Isometric',cat:'Upper',media:null,review:'PENDING',sets:4,reps:30,kg:0,rest:45,m:'Forearm extensor tendon',cue:'Neutral wrist • pain-free effort • steady hold',errors:'Maximal painful contraction • wrist deviation',alts:'Supported Wrist Extension'},
{n:'Hip Mobility Flow',cat:'Mobility',media:null,review:'PENDING',sets:2,reps:10,kg:0,rest:30,m:'Hip mobility',cue:'Slow controlled range • no forcing end range',errors:'Bouncing • lumbar compensation',alts:'90/90 Hip Rotation'}];
const RUNS=[{name:'Recovery Run',meta:'5 km • Zone 2',detail:'Easy conversational pace. Keep effort controlled.'},{name:'Interval Run',meta:'6 × 3 min • 2 min easy',detail:'Fast but controlled repetitions. Stop if mechanics deteriorate.'},{name:'Long Run',meta:'8–12 km • Zone 2',detail:'Steady aerobic endurance.'}];
const RECOVERY=[{name:'Knee Capacity',meta:'8 min',detail:'Pain-monitored isometrics and controlled range strength.'},{name:'Mobility Reset',meta:'10 min',detail:'Hip, ankle and thoracic mobility.'},{name:'Easy Recovery',meta:'15 min',detail:'Light movement and breathing.'}];
function save(noRender=false){storageSet(JSON.stringify(S));if(!noRender)render()}
function toast(t){$('toast').textContent=t;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1500)}
function readinessScore(){const r=S.readiness;return Math.round((r.sleep+r.energy+r.soreness+r.motivation+r.pain)/5)}
function readinessState(){const sc=readinessScore();if(S.pain>=7||sc<=3)return{label:'Recovery recommended',color:'var(--red)',reason:S.pain>=7?'High injury pain':'Low overall readiness'};if(S.pain>=5||sc<=6)return{label:'Reduce load',color:'var(--yellow)',reason:'Use reduced volume/intensity'};return{label:'Good to train',color:'var(--green)',reason:'Normal planned session'}}
function mediaFor(ex){return ex.media?MEDIA[ex.media]:null}
function setMedia(imgId,fallbackId,badgeId,ex){const img=$(imgId),fb=$(fallbackId),src=mediaFor(ex);const fallback=()=>{img.removeAttribute('src');img.classList.add('hidden');fb.classList.remove('hidden');if(badgeId){$(badgeId).textContent='MEDIA UNDER REVIEW';$(badgeId).style.display='block'}};if(src){img.onerror=fallback;img.onload=()=>{img.classList.remove('hidden');fb.classList.add('hidden')};img.src=src;img.classList.remove('hidden');fb.classList.add('hidden');if(badgeId){$(badgeId).textContent='ANATOMY REFERENCE';$(badgeId).style.display='block'}}else fallback()}
function render(){const ex=EX[S.ex],score=readinessScore(),rs=readinessState();$('hello').textContent=S.name?`Good Morning, ${S.name}`:"Good Morning. Let's Train.";$('drawerName').textContent=S.name||'Your Name';$('readyScore').textContent=score+'/10';$('readyText').textContent=rs.label;$('readyText').style.color=rs.color;$('readyReason').textContent=rs.reason;$('injuryFocus').textContent=(S.injury||'Recovery')+' Capacity';$('planStrength').textContent=S.pain>=7?'Upper Body + Recovery':'Lower Body Strength';$('planRun').textContent=S.pain>=7?'No Run Today':'Recovery Run';const w=S.workouts.filter(x=>Date.now()-x.date<7*864e5).length;$('weekProgress').textContent=w+'/'+S.days;$('weekBar').style.width=Math.min(100,w/Math.max(1,S.days)*100)+'%';$('exCount').textContent=`EXERCISE ${S.ex+1} OF ${EX.length}`;$('exName').textContent=ex.n;$('sets').textContent=ex.sets;$('reps').textContent=ex.reps;$('weight').textContent=ex.kg||'BW';$('rest').textContent=ex.rest+'s';$('motionNote').textContent=ex.media?'Reviewed static anatomy reference • 6-sec motion will only appear after frame-level approval':'No unverified animation shown • anatomical motion asset pending review';setMedia('exerciseMedia','mediaFallback','mediaBadge',ex);['calories','protein','water','creatine'].forEach(k=>$(k+'Val').textContent=S.nut[k]+' / '+({calories:2250,protein:140,water:2500,creatine:5}[k]));$('foodSummary').textContent=[S.allergies&&'Allergies: '+S.allergies,S.intolerances&&'Intolerances: '+S.intolerances,S.foodAvoid&&'Avoid: '+S.foodAvoid].filter(Boolean).join(' • ')||'None set';$('autoPlay').checked=S.autoPlay;$('autoStop').checked=S.autoStop;$('musicDuringRest').checked=S.musicDuringRest;renderList();renderSession();}
function showPage(p){$$('.page').forEach(x=>x.classList.toggle('active',x.dataset.page===p));$$('[data-nav]').forEach(x=>x.classList.toggle('active',x.dataset.nav===p));closeDrawer();window.scrollTo(0,0)}
function openDrawer(){$('drawer').classList.add('open');$('scrim').classList.add('show')}
function closeDrawer(){$('drawer').classList.remove('open');$('scrim').classList.remove('show')}
function modal(title,eye,html){$('modalTitle').textContent=title;$('modalEye').textContent=eye;$('modalBody').innerHTML=html;$('modal').classList.remove('hidden');closeDrawer();bindModal()}
function closeModal(){$('modal').classList.add('hidden')}
function showModal(k){
if(k==='goals')modal('Set Your Goal','GOALS',`<div class="choice">${['General Fitness','Injury Focused','5K','10K','Half Marathon','Full Marathon'].map(g=>`<button class="goalChoice ${S.goal===g?'selected':''}" data-v="${g}">${g}</button>`).join('')}</div><label class="field">Target time<input id="targetF" value="${S.target}"></label><label class="field">Target date<input id="targetDateF" type="date" value="${S.targetDate||''}"></label><label class="field">Weeks <b id="weeksOut">${S.weeks}</b><input id="weeksF" type="range" min="4" max="52" value="${S.weeks}"></label><label class="field">Days/week <b id="daysOut">${S.days}</b><input id="daysF" type="range" min="2" max="7" value="${S.days}"></label><button id="saveGoal" class="primary">SAVE GOAL</button>`);
else if(k==='programs')modal('Training Programs','PROGRAMS',`<div class="tabs"><button class="pill active" id="timeBased">TIME BASED</button><button class="pill" id="raceBased">RACE BASED</button></div><div id="programBody" class="list"><button data-weeks="8"><b>8 Week Program</b><small>Short focused block</small></button><button data-weeks="12"><b>12 Week Program</b><small>Build a strong foundation</small></button><button data-weeks="16"><b>16 Week Program</b><small>Progressive build</small></button><button data-weeks="26"><b>6 Month Program</b><small>Long-term progression</small></button><button data-weeks="52"><b>12 Month Program</b><small>Annual development</small></button></div>`);
else if(k==='injuries')modal('Injuries','RECOVERY',`<div class="choice">${['Knee','Achilles','Tennis Elbow','Hip','Lower Back','Shoulder','Ankle','Hamstring','Custom'].map(x=>`<button class="injChoice ${S.injury===x?'selected':''}" data-v="${x}">${x}</button>`).join('')}</div><label class="field">Side<select id="sideF"><option>Left</option><option>Right</option><option>Both</option></select></label><label class="field">Pain level <b id="painOut">${S.pain}/10</b><input id="painF" type="range" min="0" max="10" value="${S.pain}"></label><label class="field">Restrictions / clinician notes<textarea id="notesF">${S.notes||''}</textarea></label><button id="saveInjury" class="primary">SAVE INJURY PROFILE</button>`);
else if(k==='food')modal('Food & Allergies','NUTRITION',`<label class="field">Food allergies<textarea id="allergyF">${S.allergies||''}</textarea></label><label class="field">Intolerances<textarea id="intoleranceF">${S.intolerances||''}</textarea></label><label class="field">Foods to avoid<textarea id="avoidF">${S.foodAvoid||''}</textarea></label><button id="saveFood" class="primary">SAVE</button>`);
else if(k==='connected')modal('Connected Data','SYNC',connectedHtml());
else if(k==='progress'){const n=S.workouts.length,last=S.workouts.slice(-1)[0];modal('Your Progress','PROGRESS',`<div class="metric-grid"><div class="metric-card"><span class="eyebrow">WORKOUTS</span><b>${n}</b><span class="muted">completed</span></div><div class="metric-card"><span class="eyebrow">WEEKLY GOAL</span><b>${Math.min(S.days,S.workouts.filter(x=>Date.now()-x.date<7*864e5).length)}/${S.days}</b><span class="muted">sessions</span></div><div class="metric-card"><span class="eyebrow">CURRENT GOAL</span><b>${S.goal}</b><span class="muted">Target ${S.target}</span></div><div class="metric-card"><span class="eyebrow">PAIN</span><b>${S.pain}/10</b><span class="muted">${S.injury}</span></div></div>${last?`<div class="card"><span class="eyebrow">LAST SESSION</span><b style="display:block;margin-top:5px">${last.exercise}</b><span class="muted">${fmt(last.duration||0)} • ${last.mode||'TRAIN'}</span></div>`:''}`)}