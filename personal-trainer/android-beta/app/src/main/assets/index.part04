SESSION':'RECOVERY SESSION';$('sessionName').textContent=item.name;$('sessionMeta').textContent=item.meta;other.innerHTML=`<span class="eyebrow">${S.session}</span><h2>${item.name}</h2><div class="muted">${item.meta}</div><p>${item.detail}</p><button class="primary" id="startSimple">START ${S.session}</button>`;$('startSimple').onclick=()=>startSimpleSession(item)}}
function setEx(i){S.ex=(i+EX.length)%EX.length;save()}
function startWorkout(){if(S.session!=='TRAIN'){toast('Switch to TRAIN for exercise workout');return}secs=0;setDone=0;paused=false;restLeft=0;$('workout').classList.remove('hidden');updateWorkout();clearInterval(workoutTimer);clearInterval(restTimer);workoutTimer=setInterval(()=>{if(!paused&&restLeft===0){secs++;$('timer').textContent=fmt(secs)}},1000);if(S.autoPlay&&$('audio').src)$('audio').play().catch(()=>{})}
function updateWorkout(){const e=EX[S.ex];$('workoutName').textContent=e.n;$('wReps').textContent=e.reps;$('wWeight').textContent=(e.kg||'BW')+(e.kg?'kg':'');$('wRest').textContent=e.rest+'s';$('wDone').textContent=setDone+'/'+e.sets;$('setText').textContent=restLeft>0?'Rest':('Set '+Math.min(setDone+1,e.sets)+' of '+e.sets);setMedia('workoutMedia','workoutFallback',null,e)}
function beginRest(seconds){clearInterval(restTimer);restLeft=seconds;$('timerRing').classList.add('rest-ring');$('setText').textContent='Rest';$('timer').textContent=fmt(restLeft);if(!S.musicDuringRest&&$('audio').src)$('audio').pause();restTimer=setInterval(()=>{if(paused)return;restLeft--;if(restLeft<=0){clearInterval(restTimer);restLeft=0;$('timerRing').classList.remove('rest-ring');$('timer').textContent=fmt(secs);if(S.autoPlay&&S.musicDuringRest===false&&$('audio').src)$('audio').play().catch(()=>{});updateWorkout();toast('Rest complete')}else $('timer').textContent=fmt(restLeft)},1000)}
function completeSet(){const e=EX[S.ex];if(restLeft>0){toast('Rest in progress');return}if(setDone<e.sets){setDone++;updateWorkout();if(setDone<e.sets)beginRest(e.rest);else toast('Exercise complete')}else toast('All sets complete')}
function finishWorkout(){clearInterval(workoutTimer);clearInterval(restTimer);const e=EX[S.ex];S.workouts.push({date:Date.now(),duration:secs,exercise:e.n,sets:setDone,mode:'TRAIN'});save();$('workout').classList.add('hidden');if(S.autoStop)$('audio').pause();toast('Workout saved')}
function startSimpleSession(item){const started=Date.now();modal(item.name,S.session,`<div class="card"><b>${item.name}</b><div class="muted">${item.meta}</div><p>${item.detail}</p></div><button id="completeSimple" class="primary">COMPLETE SESSION</button>`);$('completeSimple').onclick=()=>{S.workouts.push({date:Date.now(),duration:Math.round((Date.now()-started)/1000),exercise:item.name,sets:1,mode:S.session});save();closeModal();toast('Session saved')}}
function fmt(s){return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')}
function parseActivityText(text,name){let summary='File imported';const lower=name.toLowerCase();try{if(lower.endsWith('.gpx')){const pts=[...text.matchAll(/<trkpt[^>]*lat="([\d.-]+)"[^>]*lon="([\d.-]+)"/g)].map(m=>[+m[1],+m[2]]);let km=0;for(let i=1;i<pts.length;i++)km+=hav(pts[i-1],pts[i]);summary=pts.length?`${km.toFixed(2)} km • ${pts.length} track points`:'GPX imported';}else if(lower.endsWith('.tcx')){const ds=[...text.matchAll(/<DistanceMeters>([\d.]+)<\/DistanceMeters>/g)].map(m=>+m[1]);const ts=[...text.matchAll(/<TotalTimeSeconds>([\d.]+)<\/TotalTimeSeconds>/g)].map(m=>+m[1]);summary=`${(Math.max(0,...ds)/1000).toFixed(2)} km${ts.length?' • '+fmt(Math.round(Math.max(...ts))):''}`;}else if(lower.endsWith('.csv')){const lines=text.trim().split(/\r?\n/);summary=`CSV • ${Math.max(0,lines.length-1)} data rows`;}}catch(e){summary='Imported • parsing limited'}return summary}
function hav(a,b){const R=6371,rad=x=>x*Math.PI/180,dlat=rad(b[0]-a[0]),dlon=rad(b[1]-a[1]),x=Math.sin(dlat/2)**2+Math.cos(rad(a[0]))*Math.cos(rad(b[0]))*Math.sin(dlon/2)**2;return 2*R*Math.asin(Math.sqrt(x))}
function importFile(kind,file){if(!file)return;const r=new FileReader();r.onload=()=>{S.imports[kind]={name:file.name,date:Date.now(),summary:parseActivityText(String(r.result),file.name)};save(true);showModal('connected');toast('Activity imported')};r.readAsText(file)}
function exportBackup(){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(S,null,2)],{type:'application/json'}));a.download='personal-trainer-backup.json';a.click()}
function restoreBackupFile(file){if(!file)return;const r=new FileReader();r.onload=()=>{try{S=deepMerge(defaults,JSON.parse(r.result));save();closeModal();toast('Backup restored')}catch(e){toast('Invalid backup')}};r.readAsText(file)}
$('enter').onclick=()=>{$('cover').classList.add('hidden');$('shell').classList.remove('hidden');render();buildWeek()};$('adminCover').onclick=()=>{$('cover').classList.add('hidden');$('shell').classList.remove('hidden');showModal('admin')};$('menuBtn').onclick=openDrawer;$('scrim').onclick=closeDrawer;$$('[data-nav]').forEach(b=>b.onclick=()=>showPage(b.dataset.nav));$$('[data-open]').forEach(b=>b.onclick=()=>showPage(b.dataset.open));$$('[data-modal]').forEach(b=>b.onclick=()=>showModal(b.dataset.modal));$('modalBack').onclick=closeModal;$('startToday').onclick=()=>showPage('train');$('readinessBtn').onclick=()=>showModal('readiness');$('prev').onclick=()=>setEx(S.ex-1);$('next').onclick=()=>setEx(S.ex+1);$('detailBtn').onclick=()=>detail(S.ex);$('startWorkout').onclick=startWorkout;$$('[data-session]').forEach(b=>b.onclick=()=>{S.session=b.dataset.session;save();renderSession()});$('workoutBack').onclick=()=>{paused=true;$('pause').textContent='Resume';toast('Workout paused — finish to save or resume')};$('wPrev').onclick=()=>{setEx(S.ex-1);setDone=0;restLeft=0;clearInterval(restTimer);$('timerRing').classList.remove('rest-ring');updateWorkout()};$('wNext').onclick=()=>{setEx(S.ex+1);setDone=0;restLeft=0;clearInterval(restTimer);$('timerRing').classList.remove('rest-ring');updateWorkout()};$('completeSet').onclick=completeSet;$('pause').onclick=()=>{paused=!paused;$('pause').textContent=paused?'Resume':'Pause'};$('finish').onclick=finishWorkout;$$('[data-nut]').forEach(b=>b.onclick=()=>{window.__nutKey=b.dataset.nut;showModal('nutritionEntry')});$('localMusic').onclick=()=>$('audioPick').click();$('audioPick').onchange=e=>{const f=e.target.files[0];if(f){$('audio').src=URL.createObjectURL(f);$('musicStatus').textContent=f.name;toast('Local music selected')}};$('ytMusic').onclick=()=>location.href='https://music.youtube.com/';$('spotify').onclick=()=>location.href='https://open.spotify.com/';$('autoPlay').onchange=e=>{S.autoPlay=e.target.checked;save()};$('autoStop').onchange=e=>{S.autoStop=e.target.checked;save()};$('musicDuringRest').onchange=e=>{S.musicDuringRest=e.target.checked;save()};
window.ptHandleBack=function(){if(!$('workout').classList.contains('hidden')){paused=true;$('pause').textContent='Resume';toast('Workout paused');return 'workout'}if(!$('modal').classList.contains('hidden')){closeModal();return 'modal'}if($('drawer').classList.contains('open')){closeDrawer();return 'drawer'}const active=document.querySelector('.page.active');if(active&&active.dataset.page!=='home'){showPage('home');return 'home'}if(!$('shell').classList.contains('hidden')){return 'exit'}return 'exit'};
function assert(cond,name,out){out.push((cond?'PASS ':'FAIL ')+name);return !!cond}
async function runQA(){const out=[];try{$('cover').classList.add('hidden');$('shell').classList.remove('hidden');render();buildWeek();assert(!SHELLHIDDEN(),'Enter opens shell',out);showPage('train');assert(document.querySelector('[data-page="train"]').classList.contains('active'),'Bottom/page navigation',out);S.session='RUNNING';renderSession();assert($('exerciseCard').classList.contains('hidden')&&!$('nonExerciseSession').classList.contains('hidden'),'Running tab changes content',out);S.session='RECOVERY';renderSession();assert($('sessionEye').textContent.includes('RECOVERY'),'Recovery tab changes content',out);const oldDay=S.selectedDay,oldName=$('sessionName').textContent;const nd=new Date(S.selectedDay+'T12:00:00');nd.setDate(nd.getDate()+1);S.selectedDay=nd.toISOString().slice(0,10);S.session='TRAIN';renderSession();assert($('sessionName').textContent!==oldName||S.pain>=7,'Selected day changes planned workout',out);S.selectedDay=oldDay;S.session='TRAIN';renderSession();const before=S.ex;setEx(before+1);assert(S.ex!==before,'Next exercise changes data',out);setEx(before);detail(S.ex);assert(!$('modal').classList.contains('hidden'),'Exercise detail opens',out);closeModal();showModal('goals');assert(!!$('weeksF')&&!!$('daysF'),'Goal sliders render',out);closeModal();showModal('injuries');assert(!!$('painF'),'Injury pain slider renders',out);closeModal();showModal('connected');assert($$('.importBtn').length===2&&$$('.importInput').every(x=>x.classList.contains('hidden')),'Connected Data uses styled import buttons',out);closeModal();const fake=parseActivityText('<gpx><trk><trkseg><trkpt lat="35" lon="33"></trkpt><trkpt lat="35.01" lon="33.01"></trkpt></trkseg></trk></gpx>','x.gpx');assert(fake.includes('km'),'GPX parser works',out);startWorkout();assert(!$('workout').classList.contains('hidden'),'Workout starts',out);const d=setDone;completeSet();assert(setDone===d+1,'Complete set increments',out);clearInterval(restTimer);restLeft=0;finishWorkout();assert($('workout').classList.contains('hidden')&&S.workouts.length>0,'Workout finish saves history',out);window.__nutKey='protein';showModal('nutritionEntry');assert(!!$('nutF'),'Nutrition editor works without browser prompt',out);closeModal();assert(mediaFor(EX[0])&&mediaFor(EX[1]),'Primary anatomy references bundled',out);assert(!mediaFor(EX[2]),'Unreviewed anatomy stays hidden',out);showPage('home');}catch(e){out.push('ERROR '+e.message)}$('qa').textContent=out.join('\n');$('qa').classList.remove('hidden');window.__QA__=out;document.title='QA '+out.filter(x=>x.startsWith('PAS