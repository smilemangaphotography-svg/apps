<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Personal Trainer</title><style>
:root{--bg:#05090c;--card:#11181d;--card2:#182126;--line:#28343b;--txt:#f5f7f8;--muted:#91a0a8;--orange:#ff7518;--blue:#39bdf8;--green:#38d17a;--red:#ff4d55}*{box-sizing:border-box}html,body{margin:0;background:#000;color:var(--txt);font-family:Inter,system-ui,-apple-system,Roboto,Arial,sans-serif;min-height:100%;overscroll-behavior:none}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}.cover{height:100dvh;min-height:700px;position:relative;overflow:hidden;background:#000}.cover:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.14) 35%,rgba(0,0,0,.75) 72%,#000),url('https://images.unsplash.com/photo-1744551472645-7fd56c0406ff?auto=format&fit=crop&q=86&w=1400') center 28%/cover no-repeat}.cover-copy{position:absolute;left:24px;right:24px;bottom:29%;z-index:2}.cover h1{font-size:44px;line-height:.88;margin:0;font-weight:950;letter-spacing:-2px}.cover h1 span{color:var(--orange)}.cover .tag{font-size:12px;letter-spacing:3px;font-weight:800;margin-top:14px}.enter{position:absolute;z-index:3;left:22px;right:22px;bottom:17%;height:58px;border:0;border-radius:12px;background:linear-gradient(180deg,#ff8d28,#ff6d0a);font-weight:950;font-size:18px}.admin-cover{position:absolute;z-index:4;bottom:7.1%;left:50%;transform:translateX(-50%);background:transparent;border:0;color:white;display:grid;gap:4px;place-items:center;font-size:24px}.admin-cover small{font-size:10px;color:#ddd}.motto{position:absolute;bottom:2.2%;width:100%;text-align:center;color:#748089;font-size:8px;letter-spacing:3px;font-weight:800;z-index:2}.shell{min-height:100dvh;background:linear-gradient(180deg,#071016,#030608 45%);padding-bottom:78px}.top{height:58px;display:flex;align-items:center;gap:12px;padding:8px 14px;position:sticky;top:0;background:rgba(5,9,12,.92);backdrop-filter:blur(16px);z-index:20;border-bottom:1px solid #111}.icon{width:42px;height:42px;border:0;background:transparent;color:white;font-size:23px}.brand{font-weight:900;letter-spacing:.5px}.page{display:none;padding:14px}.page.active{display:block}.hero{height:240px;border-radius:18px;overflow:hidden;position:relative;background:url('https://cdn.prod.website-files.com/673a36c9c49964cb6640a2ad/673a36c9c49964cb6640a4ac_Mountain%20Trail%20Run.webp') center/cover}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.05),rgba(0,0,0,.82))}.hero-text{position:absolute;z-index:2;left:18px;right:18px;bottom:16px}.hero h2{font-size:27px;margin:0}.hero p{margin:4px 0 0;color:#ddd}.card{background:linear-gradient(145deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:15px;padding:14px;margin-top:12px;box-shadow:0 8px 30px rgba(0,0,0,.24)}.row{display:flex;gap:10px;align-items:center}.between{justify-content:space-between}.eyebrow{font-size:10px;letter-spacing:1.7px;color:#a9b4ba;font-weight:900}.big{font-size:24px;font-weight:950}.muted{color:var(--muted);font-size:12px}.readiness{display:flex;align-items:center;gap:12px}.ring{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;border:5px solid var(--green);font-weight:950}.plan-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mini{padding:14px;border-radius:13px;background:#121a1f;border:1px solid #26343b}.mini strong{display:block;margin-top:5px}.primary{width:100%;height:52px;border:0;border-radius:11px;background:linear-gradient(#ff8b25,#ff6b08);font-weight:950;color:#090909;margin-top:12px}.secondary{height:44px;border:1px solid #46535b;background:#10171b;color:#fff;border-radius:10px;padding:0 14px}.bottom{position:fixed;z-index:30;bottom:0;left:0;right:0;height:70px;padding:6px 8px max(6px,env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(5,1fr);background:#05090c;border-top:1px solid #263139}.bottom button{border:0;background:transparent;color:#8d999f;font-size:20px}.bottom button small{display:block;font-size:9px;margin-top:3px}.bottom button.active{color:var(--orange)}.drawer{position:fixed;z-index:60;top:0;bottom:0;left:0;width:min(86%,340px);background:#060b0e;transform:translateX(-105%);transition:.2s;padding:22px 15px;overflow:auto}.drawer.open{transform:none}.scrim{position:fixed;inset:0;background:#0009;z-index:50;display:none}.scrim.show{display:block}.profile{display:flex;gap:12px;align-items:center;padding:12px 4px 20px;border-bottom:1px solid #223039}.avatar{width:54px;height:54px;border-radius:50%;background:linear-gradient(145deg,#444,#111);display:grid;place-items:center;font-weight:950}.menu button{display:flex;align-items:center;width:100%;height:50px;border:0;background:transparent;color:white;border-bottom:1px solid #152026;text-align:left;font-weight:750}.menu button span{width:34px;color:var(--orange)}.week{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}.day{padding:8px 2px;background:#11191d;border:1px solid #26343b;border-radius:10px;color:#e8eef0;text-align:center}.day small{font-size:9px;display:block}.day.active{background:var(--orange);color:#090909;border-color:var(--orange)}.tabs{display:flex;gap:7px;margin-top:12px}.pill{border:1px solid #2a3940;color:#9eabb1;background:#10171b;border-radius:20px;padding:7px 12px;font-size:10px;font-weight:900}.pill.active{background:var(--orange);color:#080808;border-color:var(--orange)}.exercise-stage{height:320px;border-radius:16px;background:radial-gradient(circle at 50% 38%,#20282d,#070a0c 68%);margin-top:12px;position:relative;display:grid;place-items:center;overflow:hidden}.motion-frame{position:absolute;max-height:88%;max-width:94%;filter:drop-shadow(0 14px 25px #000);opacity:0;transition:opacity .25s}.motion-frame.show{opacity:1}.motion-note{position:absolute;left:10px;right:10px;bottom:8px;text-align:center;color:#b9c1c5;font-size:10px;background:#000b;padding:6px;border-radius:8px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:10px}.stat{background:#151f24;border:1px solid #29383f;border-radius:10px;padding:10px;text-align:center}.stat small{font-size:9px;color:#93a1a8}.stat strong{display:block;font-size:18px;margin-top:3px}.controls{display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:7px}.list{display:grid;gap:9px;margin-top:12px}.list button{border:1px solid #2a373e;background:linear-gradient(145deg,#182126,#0f1519);color:white;border-radius:13px;padding:14px;text-align:left}.list button strong{display:block}.list button small{color:#91a0a8}.filters{display:flex;gap:6px;overflow:auto}.source{display:grid;grid-template-columns:1fr;gap:9px}.source button{height:68px;border:1px solid #2a393f;background:#141d22;color:#fff;border-radius:13px;text-align:left;padding:0 14px}.source button.active{border-color:var(--orange)}.tog{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #26333a}.tog input{width:22px;height:22px;accent-color:var(--orange)}.nut-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.nut{min-height:108px}.nut strong{font-size:25px;display:block;margin-top:7px}.modal{position:fixed;inset:0;z-index:100;background:#020506;overflow:auto;padding:18px 14px 90px}.modal-head{display:flex;align-items:center;gap:10px;position:sticky;top:-18px;padding:8px 0;background:#020506;z-index:2}.modal h2{margin:6px 0 12px}.field{display:grid;gap:6px;margin:12px 0}.field input,.field select,.field textarea{background:#10181c;border:1px solid #35444b;color:white;border-radius:10px;padding:12px;min-height:44px}.field input[type=range]{padding:0;accent-color:var(--orange)}.choice{display:grid;grid-template-columns:1fr 1fr;gap:8px}.choice button{min-height:54px;border:1px solid #314047;background:#111a1f;color:#fff;border-radius:10px}.choice button.selected{border-color:var(--orange);box-shadow:inset 0 0 0 1px var(--orange)}.workout-overlay{position:fixed;inset:0;z-index:120;background:#020405;padding:18px 14px 20px;overflow:auto}.timer-ring{width:170px;height:170px;margin:18px auto;border-radius:50%;border:8px solid #28343b;border-right-color:var(--orange);display:grid;place-items:center;text-align:center}.timer-ring strong{font-size:36px}.workout-image{height:330px;position:relative;display:grid;place-items:center}.workout-image .motion-frame{max-height:100%}.danger{background:var(--red);color:#fff}.progressbar{height:8px;border-radius:10px;background:#26333a;overflow:hidden}.progressbar i{display:block;height:100%;background:var(--green)}.toast{position:fixed;z-index:200;left:50%;bottom:90px;transform:translateX(-50%);background:#fff;color:#111;padding:10px 14px;border-radius:20px;font-size:12px;font-weight:800;display:none;white-space:nowrap}.toast.show{display:block}@media(min-width:700px){body{max-width:430px;margin:auto;box-shadow:0 0 0 1px #222;min-height:100vh}.bottom{left:50%;right:auto;width:430px;transform: