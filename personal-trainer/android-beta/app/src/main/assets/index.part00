<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Personal Trainer</title>
<style>
:root{--bg:#04080b;--card:#121a1f;--card2:#172126;--line:#2a363d;--txt:#f4f6f7;--muted:#93a1a8;--orange:#ff7518;--orange2:#ff8c28;--green:#38d17a;--yellow:#f6c945;--red:#ff4f57;--blue:#38bdf8}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#000;color:var(--txt);font-family:Inter,system-ui,-apple-system,Roboto,Arial,sans-serif;overscroll-behavior:none}body{max-width:560px;margin:0 auto;background:linear-gradient(#071016,#030608 42%)}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}.cover{height:100dvh;min-height:640px;position:relative;overflow:hidden;background:#000}.cover:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.06),rgba(0,0,0,.18) 38%,rgba(0,0,0,.80) 77%,#000),url('https://images.unsplash.com/photo-1744551472645-7fd56c0406ff?auto=format&fit=crop&q=88&w=1400') center 28%/cover no-repeat}.cover-copy{position:absolute;left:24px;right:24px;bottom:30%;z-index:2}.cover h1{font-size:48px;line-height:.88;margin:0;font-weight:950;letter-spacing:-2px}.cover h1 span{color:var(--orange)}.cover .tag{font-size:12px;letter-spacing:3px;font-weight:850;margin-top:15px;line-height:1.45}.enter{position:absolute;z-index:3;left:22px;right:22px;bottom:17%;height:60px;border:0;border-radius:14px;background:linear-gradient(180deg,var(--orange2),#ff6806);font-weight:950;font-size:19px}.admin-cover{position:absolute;z-index:4;bottom:7.3%;left:50%;transform:translateX(-50%);background:transparent;border:0;color:white;display:grid;gap:5px;place-items:center;font-size:27px;padding:10px 24px}.admin-cover small{font-size:11px;color:#ddd}.motto{position:absolute;bottom:2.5%;width:100%;text-align:center;color:#79848a;font-size:8px;letter-spacing:3px;font-weight:850;z-index:2}.shell{min-height:100dvh;background:linear-gradient(180deg,#071016,#030608 48%);padding-bottom:86px}.top{height:62px;display:flex;align-items:center;gap:10px;padding:8px 14px;position:sticky;top:0;background:rgba(5,9,12,.96);backdrop-filter:blur(16px);z-index:20;border-bottom:1px solid #151d21}.icon{width:42px;height:42px;border:0;background:transparent;color:white;font-size:23px}.brand{font-weight:920;letter-spacing:.3px;font-size:18px}.page{display:none;padding:16px}.page.active{display:block}.hero{height:224px;border-radius:18px;overflow:hidden;position:relative;background:url('https://cdn.prod.website-files.com/673a36c9c49964cb6640a2ad/673a36c9c49964cb6640a4ac_Mountain%20Trail%20Run.webp') center/cover}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.04),rgba(0,0,0,.84))}.hero-text{position:absolute;z-index:2;left:18px;right:18px;bottom:16px}.hero h2{font-size:29px;line-height:1.04;margin:2px 0}.hero p{margin:7px 0 0;color:#e6e8e9}.card{background:linear-gradient(145deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:16px;padding:15px;margin-top:12px;box-shadow:0 9px 30px rgba(0,0,0,.24)}.row{display:flex;gap:10px;align-items:center}.between{justify-content:space-between}.eyebrow{font-size:10px;letter-spacing:1.8px;color:#aab4b9;font-weight:900}.big{font-size:26px;font-weight:950}.muted{color:var(--muted);font-size:12px}.readiness{width:100%;display:flex;align-items:center;gap:14px;color:#fff;text-align:left}.ring{width:62px;height:62px;flex:0 0 62px;border-radius:50%;display:grid;place-items:center;border:5px solid var(--green);font-weight:950}.plan-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.mini{padding:14px;border-radius:13px;background:#11191d;border:1px solid #27343b;min-height:105px}.mini .glyph{font-size:18px;color:var(--orange)}.mini strong{display:block;margin:7px 0 3px}.primary{width:100%;height:54px;border:0;border-radius:12px;background:linear-gradient(#ff8b25,#ff6b08);font-weight:950;color:#090909;margin-top:12px}.secondary{height:46px;border:1px solid #46535b;background:#10171b;color:#fff;border-radius:11px;padding:0 14px}.bottom{position:fixed;z-index:30;bottom:0;left:50%;transform:translateX(-50%);width:min(560px,100%);height:76px;padding:7px 8px;display:grid;grid-template-columns:repeat(5,1fr);background:#05090c;border-top:1px solid #263139}.bottom button{border:0;background:transparent;color:#839097;font-size:20px}.bottom button small{display:block;font-size:9px;margin-top:3px}.bottom button.active{color:var(--orange)}.drawer{position:fixed;z-index:60;top:0;bottom:0;left:0;width:min(86%,350px);background:#060b0e;transform:translateX(-105%);transition:.2s;padding:22px 15px;overflow:auto}.drawer.open{transform:none}.scrim{position:fixed;inset:0;background:#000a;z-index:50;display:none}.scrim.show{display:block}.profile{display:flex;gap:12px;align-items:center;padding:12px 4px 20px;border-bottom:1px solid #223039}.avatar{width:54px;height:54px;border-radius:50%;background:linear-gradient(145deg,#555,#111);display:grid;place-items:center;font-weight:950}.menu button{display:flex;align-items:center;width:100%;height:50px;border:0;background:transparent;color:white;border-bottom:1px solid #152026;text-align:left;font-weight:760}.menu button span{width:36px;color:var(--orange)}.week{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.day{padding:9px 2px;background:#11191d;border:1px solid #26343b;border-radius:11px;color:#e8eef0;text-align:center}.day small{font-size:9px;display:block}.day b{font-size:16px}.day.active{background:var(--orange);color:#090909;border-color:var(--orange)}.tabs{display:flex;gap:7px;margin-top:13px;overflow:auto}.pill{border:1px solid #2a3940;color:#9eabb1;background:#10171b;border-radius:22px;padding:8px 14px;font-size:10px;font-weight:900;white-space:nowrap}.pill.active{background:var(--orange);color:#080808;border-color:var(--orange)}.session-summary{display:grid;gap:4px}.session-summary h3{margin:2px 0}.exercise-stage{min-height:315px;border-radius:17px;background:radial-gradient(circle at 50% 36%,#20282d,#070a0c 68%);margin-top:12px;position:relative;display:grid;place-items:center;overflow:hidden}.anatomy{max-height:88%;max-width:92%;object-fit:contain;filter:drop-shadow(0 14px 25px #000)}.media-fallback{display:grid;place-items:center;text-align:center;padding:30px;color:#95a1a7;gap:9px}.media-fallback .lock{font-size:30px}.media-badge{position:absolute;right:10px;top:10px;padding:6px 8px;border-radius:9px;background:#0a0f12d9;border:1px solid #33424a;color:#d9e0e3;font-size:9px;font-weight:900;letter-spacing:.8px}.motion-note{position:absolute;left:10px;right:10px;bottom:8px;text-align:center;color:#b9c1c5;font-size:10px;background:#000c;padding:7px;border-radius:9px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:10px}.stat{background:#151f24;border:1px solid #29383f;border-radius:11px;padding:11px 4px;text-align:center}.stat small{font-size:9px;color:#93a1a8}.stat strong{display:block;font-size:18px;margin-top:4px}.controls{display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:7px}.list{display:grid;gap:10px;margin-top:12px}.list button{border:1px solid #2a373e;background:linear-gradient(145deg,#182126,#0f1519);color:white;border-radius:14px;padding:15px;text-align:left}.list button strong{display:block;font-size:16px;line-height:1.2}.list button small{display:block;color:#91a0a8;margin-top:5px;line-height:1.35}.statusline{margin-top:7px;font-size:10px;font-weight:850;color:var(--green)}.statusline.pending{color:var(--yellow)}.filters{display:flex;gap:6px;overflow:auto;padding-bottom:3px}.source{display:grid;gap:9px}.source button{min-height:70px;border:1px solid #2a393f;background:#141d22;color:#fff;border-radius:13px;text-align:left;padding:12px 14px}.source button.active{border-color:var(--orange)}.tog{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #26333a}.tog input{width:22px;height:22px;accent-color:var(--orange)}.nut-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.nut{min-height:112px;text-align:left;color:white}.nut strong{font-size:25px;display:block;margin-top:7px}.modal{position:fixed;inset:0;z-index:100;background:#020506;overflow:auto;padding:18px 14px 94px}.modal-head{display:flex;align-items:center;gap:10px;position:sticky;top:-18px;padding:8px 0;background:#020506;z-index:2}.modal h2{margin:6px 0 12px}.field{display:grid;gap:7px;margin:13px 0}.field input,.field select,.field textarea{background:#10181c;border:1px solid #35444b;color:white;border-radius:11px;padding:12px;min-height:46px}.field input[type=range]{padding:0;accent-color:var(--orange)}.choice{display:grid;grid-template-columns:1fr 1fr;gap:8px}.choice button{min-height:56px;border:1px solid #314047;background:#111a1f;color:#fff;border-radius:11px}.choice button.selected{border-color:var(--orange);box-shadow:inset 0 0 0 1px var(--orange)}.import-card{display:grid;gap:8px}.import-row{display:flex;justify-content:space-between;align-items:center;gap:10px}.connect-state{font-size:10px;padding:5px 8px;border-radius:10px;background:#192229;color:#aab5ba}.import-summary{padding:9px 10px;border-radius:10px;background:#0d1418;color:#b6c0c4;font-size:11px;line-height:1.4}.workout-overlay{position:fixed;inset:0;z-index:120;background:#020405;padding:18px 14px 96px;overflow:auto}.timer-ring{width:170px;height:170px;margin:18px auto;border-radius:50%;border:8px solid #28343b;border-right-color:var(--orange);display:grid;place-items:center;text-align:center}.timer-ring strong{font-size:36px}.rest-ring{border-color:#314048;border-right-color:var(--blue)}.workout-image{min-height:300px;position:relative;display:grid;place-items:center}.workout-image img{max-height:300px;max-width:94%;object-fit:contain}.danger{background:var(--red);color:#fff}.progressbar{height:8px;border-radius:10px;background:#26333a;overflow:hidden}.progressbar i{display:block;height:100%;background:var(--gr