eyebrow">CURRENT GOAL</span><b>${S.goal}</b><span class="muted">${S.target||'No target time'}</span></div><div class="metric-card"><span class="eyebrow">PAIN</span><b>${S.pain}/10</b><span class="muted">${S.injury}</span></div></div>${last?`<div class="card"><b>Last workout</b><div class="muted">${last.exercise} • ${fmt(last.duration)} • ${last.sets} sets</div></div>`:''}`)}
else if(k==='settings')modal('Settings','APP',`<label class="field">Name<input id="nameF" value="${S.name||''}"></label><button id="saveSettings" class="primary">SAVE PROFILE</button><button id="backup" class="secondary" style="width:100%;margin-top:10px">EXPORT BACKUP</button><button id="restoreBtn" class="secondary" style="width:100%;margin-top:10px">RESTORE BACKUP</button><input id="restore" class="hidden" type="file" accept="application/json">`);
else if(k==='admin')modal('Admin Panel','ADMIN',`<div class="card"><b>Admin controls</b><div class="muted">Protected editor for program defaults and beta reset.</div></div><label class="field">Admin PIN<input id="pinF" type="password" placeholder="1234"></label><button id="unlockAdmin" class="primary">UNLOCK</button><div id="adminTools" class="hidden"><label class="field">Default training days<input id="adminDays" type="number" min="2" max="7" value="${S.days}"></label><label class="field">Default goal<input id="adminGoal" value="${S.goal}"></label><button id="adminSave" class="primary">SAVE DEFAULTS</button><button id="reset" class="primary danger">RESET ALL BETA DATA</button></div>`);
else if(k==='readiness')modal('Daily Readiness','TODAY',readinessHtml());
else if(k==='nutritionEntry'){const key=window.__nutKey;modal('Update '+key.toUpperCase(),'NUTRITION',`<label class="field">Consumed today<input id="nutF" type="number" min="0" value="${S.nut[key]}"></label><button id="saveNut" class="primary">SAVE</button>`)}
}
function readinessHtml(){const rows=[['sleep','Sleep quality'],['energy','Energy'],['soreness','Muscle readiness'],['motivation','Motivation'],['pain','Injury comfort']];return rows.map(([k,l])=>`<label class="field">${l} <b id="${k}Out">${S.readiness[k]}/10</b><input data-ready="${k}" type="range" min="1" max="10" value="${S.readiness[k]}"></label>`).join('')+`<button id="saveReadiness" class="primary">SAVE READINESS</button>`}
function connectedHtml(){function one(k,name){const v=S.imports[k];return `<div class="card import-card"><div class="import-row"><div><b>${name}</b><div class="muted">${k==='garmin'?'Garmin API sync requires authorization.':'Strava OAuth requires app credentials.'}</div></div><span class="connect-state">${v?'IMPORTED':'NOT CONNECTED'}</span></div><button class="secondary importBtn" data-import="${k}">IMPORT ACTIVITY FILE</button><input class="hidden importInput" id="${k}Import" data-import="${k}" type="file" accept=".gpx,.tcx,.csv,text/*">${v?`<div class="import-summary"><b>Last import</b><br>${v.name}<br>${v.summary}<br>${new Date(v.date).toLocaleString()}</div>`:''}</div>`}return one('garmin','Garmin')+one('strava','Strava')}
function bindModal(){const body=$('modalBody'),q=s=>body.querySelector(s),qa=s=>[...body.querySelectorAll(s)];qa('.goalChoice').forEach(b=>b.onclick=()=>{S.goal=b.dataset.v;qa('.goalChoice').forEach(x=>x.classList.remove('selected'));b.classList.add('selected')});if(q('#weeksF'))q('#weeksF').oninput=e=>q('#weeksOut').textContent=e.target.value;if(q('#daysF'))q('#daysF').oninput=e=>q('#daysOut').textContent=e.target.value;if(q('#saveGoal'))q('#saveGoal').onclick=()=>{S.target=q('#targetF').value;S.targetDate=q('#targetDateF').value;S.weeks=+q('#weeksF').value;S.days=+q('#daysF').value;save();closeModal();toast('Goal saved')};qa('[data-weeks]').forEach(b=>b.onclick=()=>{S.weeks=+b.dataset.weeks;save();closeModal();toast('Program selected')});if(q('#raceBased'))q('#raceBased').onclick=()=>{q('#timeBased').classList.remove('active');q('#raceBased').classList.add('active');q('#programBody').innerHTML=['5K','10K','Half Marathon','Full Marathon'].map(g=>`<button data-race="${g}"><b>${g} Program</b><small>Race-specific progression</small></button>`).join('');[...q('#programBody').querySelectorAll('[data-race]')].forEach(b=>b.onclick=()=>{S.goal=b.dataset.race;save();closeModal();toast('Race program selected')})};qa('.injChoice').forEach(b=>b.onclick=()=>{S.injury=b.dataset.v;qa('.injChoice').forEach(x=>x.classList.remove('selected'));b.classList.add('selected')});if(q('#sideF'))q('#sideF').value=S.side;if(q('#painF'))q('#painF').oninput=e=>q('#painOut').textContent=e.target.value+'/10';if(q('#saveInjury'))q('#saveInjury').onclick=()=>{S.side=q('#sideF').value;S.pain=+q('#painF').value;S.notes=q('#notesF').value;save();closeModal();toast('Injury profile saved')};if(q('#saveFood'))q('#saveFood').onclick=()=>{S.allergies=q('#allergyF').value;S.intolerances=q('#intoleranceF').value;S.foodAvoid=q('#avoidF').value;save();closeModal();toast('Food profile saved')};if(q('#saveSettings'))q('#saveSettings').onclick=()=>{S.name=q('#nameF').value;save();closeModal();toast('Profile saved')};if(q('#backup'))q('#backup').onclick=exportBackup;if(q('#restoreBtn'))q('#restoreBtn').onclick=()=>q('#restore').click();if(q('#restore'))q('#restore').onchange=e=>restoreBackupFile(e.target.files[0]);qa('.importBtn').forEach(b=>b.onclick=()=>q('#'+b.dataset.import+'Import').click());qa('.importInput').forEach(inp=>inp.onchange=e=>importFile(inp.dataset.import,e.target.files[0]));if(q('#unlockAdmin'))q('#unlockAdmin').onclick=()=>{if(q('#pinF').value===S.adminPin){q('#adminTools').classList.remove('hidden');toast('Admin unlocked')}else toast('Wrong PIN')};if(q('#adminSave'))q('#adminSave').onclick=()=>{S.days=Math.max(2,Math.min(7,+q('#adminDays').value));S.goal=q('#adminGoal').value||S.goal;save();closeModal();toast('Admin defaults saved')};if(q('#reset'))q('#reset').onclick=()=>{storageRemove();location.reload()};qa('[data-ready]').forEach(i=>i.oninput=e=>q('#'+i.dataset.ready+'Out').textContent=e.target.value+'/10');if(q('#saveReadiness'))q('#saveReadiness').onclick=()=>{qa('[data-ready]').forEach(i=>S.readiness[i.dataset.ready]=+i.value);save();closeModal();toast('Readiness updated')};if(q('#saveNut'))q('#saveNut').onclick=()=>{S.nut[window.__nutKey]=Math.max(0,+q('#nutF').value||0);save();closeModal();toast('Nutrition updated')}}
function detail(i){S.ex=i;const ex=EX[i],src=mediaFor(ex);modal(ex.n,'EXERCISE DETAIL',`<div class="exercise-stage">${src?`<img class="anatomy" src="${src}"><div class="media-badge">ANATOMY REFERENCE</div>`:`<div class="media-fallback"><div class="lock">◇</div><b>Motion asset under review</b><span class="muted">No unverified anatomy is shown.</span></div>`}<div class="motion-note">${src?'Reviewed static reference':'Pending reviewed asset'}</div></div><div class="card"><b>Primary muscles</b><div class="muted">${ex.m}</div></div><div class="card"><b>Technique cue</b><div class="muted">${ex.cue}</div></div><div class="card"><b>Common mistakes</b><div class="muted">${ex.errors}</div></div><div class="card"><b>Alternatives</b><div class="muted">${ex.alts}</div></div><div class="stats"><div class="stat"><small>SETS</small><strong>${ex.sets}</strong></div><div class="stat"><small>REPS</small><strong>${ex.reps}</strong></div><div class="stat"><small>WEIGHT</small><strong>${ex.kg||'BW'}</strong></div><div class="stat"><small>REST</small><strong>${ex.rest}s</strong></div></div><button id="addWorkout" class="primary">USE IN TODAY'S WORKOUT</button>`);$('addWorkout').onclick=()=>{closeModal();showPage('train');render();toast('Exercise selected')}}
function renderList(){const cats=['All','Lower','Upper','Rehab','Mobility'];$('filters').innerHTML=cats.map(c=>`<button class="pill ${S.filter===c?'active':''}" data-f="${c}">${c}</button>`).join('');$$('[data-f]').forEach(b=>b.onclick=()=>{S.filter=b.dataset.f;save()});$('exerciseList').innerHTML=EX.map((e,i)=>({e,i})).filter(x=>S.filter==='All'||x.e.cat===S.filter).map(x=>`<button data-ex="${x.i}"><strong>${x.e.n}</strong><small>${x.e.m}</small><div class="statusline ${x.e.media?'':'pending'}">${x.e.media?'✓ Reviewed anatomy reference':'Motion pending review'}</div></button>`).join('');$$('[data-ex]').forEach(b=>b.onclick=()=>detail(+b.dataset.ex))}
function buildWeek(){const d=new Date(),mon=new Date(d);mon.setDate(d.getDate()-(d.getDay()?d.getDay()-1:6));$('week').innerHTML='';['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach((n,i)=>{const x=new Date(mon);x.setDate(mon.getDate()+i);const iso=x.toISOString().slice(0,10),b=document.createElement('button');b.className='day'+(S.selectedDay===iso?' active':'');b.innerHTML=`<small>${n}</small><b>${x.getDate()}</b>`;b.onclick=()=>{S.selectedDay=iso;if(S.session==='TRAIN'&&S.pain<7)S.ex=(STRENGTH[i]||STRENGTH[0]).ex;save();buildWeek();renderSession()};$('week').appendChild(b)})}
function dayIndex(){const d=new Date(S.selectedDay+'T12:00:00');return (d.getDay()+6)%7}
const STRENGTH=[{name:'Lower Body Strength',meta:'45 min • Gym',ex:0},{name:'Upper Body + Core',meta:'40 min • Gym',ex:4},{name:'Lower Body Capacity',meta:'45 min • Gym',ex:1},{name:'Full Body Strength',meta:'45 min • Gym',ex:0},{name:'Lower Body Strength',meta:'45 min • Gym',ex:1},{name:'Recovery Strength',meta:'30 min • Controlled',ex:3},{name:'Mobility + Reset',meta:'25 min • Recovery',ex:5}];
function renderSession(){$$('[data-session]').forEach(b=>b.classList.toggle('active',b.dataset.session===S.session));const card=$('exerciseCard'),other=$('nonExerciseSession');if(S.session==='TRAIN'){card.classList.remove('hidden');other.classList.add('hidden');const planned=STRENGTH[dayIndex()]||STRENGTH[0];$('sessionEye').textContent='STRENGTH SESSION';$('sessionName').textContent=S.pain>=7?'Upper Body + Recovery':planned.name;$('sessionMeta').textContent=S.pain>=7?'30 min • Modified for pain':planned.meta;}else{card.classList.add('hidden');other.classList.remove('hidden');const idx=dayIndex()%3,item=(S.session==='RUNNING'?RUNS:RECOVERY)[idx];$('sessionEye').textContent=S.session==='RUNNING'?'RUNNING 