ackup').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(S,null,2)],{type:'application/json'}));a.download='personal-trainer-backup.json';a.click()};if(q('#restore'))q('#restore').onchange=e=>{const r=new FileReader();r.onload=()=>{try{S=Object.assign({},defaults,JSON.parse(r.result));save();closeModal();toast('Backup restored')}catch{toast('Invalid backup')}};r.readAsText(e.target.files[0])};['garminImport','stravaImport'].forEach(id=>{if(q('#'+id))q('#'+id).onchange=e=>{if(e.target.files[0])toast(e.target.files[0].name+' imported')}});if(q('#unlockAdmin'))q('#unlockAdmin').onclick=()=>{if(q('#pinF').value===S.adminPin){q('#adminTools').classList.remove('hidden');toast('Admin unlocked')}else toast('Wrong PIN')};if(q('#adminSave'))q('#adminSave').onclick=()=>{S.days=Math.max(2,Math.min(7,+q('#adminDays').value));save();closeModal();toast('Admin defaults saved')};if(q('#reset'))q('#reset').onclick=()=>{localStorage.removeItem(KEY);location.reload()}}
function detail(i){S.ex=i;const ex=EX[i];modal(ex.n,'EXERCISE DETAIL',`<div class="exercise-stage"><img id="d1" class="motion-frame"><img id="d2" class="motion-frame"><img id="d3" class="motion-frame"><div class="motion-note">${ex.slug?'Start → Mid → End anatomical sequence':'No motion shown until reviewed asset is available'}</div></div><div class="card"><b>Primary muscles</b><div class="muted">${ex.m}</div></div><div class="stats"><div class="stat"><small>SETS</small><strong>${ex.sets}</strong></div><div class="stat"><small>REPS</small><strong>${ex.reps}</strong></div><div class="stat"><small>WEIGHT</small><strong>${ex.kg||'BW'}</strong></div><div class="stat"><small>REST</small><strong>${ex.rest}s</strong></div></div><button id="addWorkout" class="primary">ADD TO WORKOUT</button>`);cycle(['d1','d2','d3'],ex);$('addWorkout').onclick=()=>{closeModal();showPage('train');toast('Exercise selected')}}
function renderList(){const cats=['All','Lower','Upper','Rehab','Mobility'];$('filters').innerHTML=cats.map(c=>`<button class="pill ${S.filter===c?'active':''}" data-f="${c}">${c}</button>`).join('');$$('[data-f]').forEach(b=>b.onclick=()=>{S.filter=b.dataset.f;save()});$('exerciseList').innerHTML=EX.map((e,i)=>({e,i})).filter(x=>S.filter==='All'||x.e.cat===S.filter).map(x=>`<button data-ex="${x.i}"><b>${x.e.n}</b><small>${x.e.m}${x.e.slug?' • 3-pose motion':' • motion pending review'}</small></button>`).join('');$$('[data-ex]').forEach(b=>b.onclick=()=>detail(+b.dataset.ex))}
function buildWeek(){const d=new Date(),mon=new Date(d);mon.setDate(d.getDate()-(d.getDay()?d.getDay()-1:6));$('week').innerHTML='';['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach((n,i)=>{const x=new Date(mon);x.setDate(mon.getDate()+i);const b=document.createElement('button');b.className='day'+(x.toDateString()===d.toDateString()?' active':'');b.innerHTML=`<small>${n}</small><b>${x.getDate()}</b>`;b.onclick=()=>{$$('.day').forEach(y=>y.classList.remove('active'));b.classList.add('active');toast('Day selected')};$('week').appendChild(b)})}
function setEx(i){S.ex=(i+EX.length)%EX.length;save()}function startWorkout(){secs=0;setDone=0;paused=false;$('workout').classList.remove('hidden');updateWorkout();clearInterval(workoutTimer);workoutTimer=setInterval(()=>{if(!paused){secs++;$('timer').textContent=fmt(secs)}},1000);if(S.autoPlay&&$('audio').src)$('audio').play().catch(()=>{})}function updateWorkout(){const e=EX[S.ex];$('workoutName').textContent=e.n;$('wReps').textContent=e.reps;$('wWeight').textContent=(e.kg||'BW')+(e.kg?'kg':'');$('wRest').textContent=e.rest+'s';$('wDone').textContent=setDone+'/'+e.sets;$('setText').textContent='Set '+Math.min(setDone+1,e.sets)+' of '+e.sets;cycle(['wf1','wf2','wf3'],e)}function finishWorkout(){clearInterval(workoutTimer);const e=EX[S.ex];S.workouts.push({date:Date.now(),duration:secs,exercise:e.n,sets:setDone});save();$('workout').classList.add('hidden');if(S.autoStop)$('audio').pause();toast('Workout saved')}function fmt(s){return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')}
$('enter').onclick=()=>{$('cover').classList.add('hidden');$('shell').classList.remove('hidden');render()};$('adminCover').onclick=()=>{ $('cover').classList.add('hidden');$('shell').classList.remove('hidden');showModal('admin')};$('menuBtn').onclick=openDrawer;$('scrim').onclick=closeDrawer;$$('[data-nav]').forEach(b=>b.onclick=()=>showPage(b.dataset.nav));$$('[data-open]').forEach(b=>b.onclick=()=>showPage(b.dataset.open));$$('[data-modal]').forEach(b=>b.onclick=()=>showModal(b.dataset.modal));$('modalBack').onclick=closeModal;$('startToday').onclick=()=>showPage('train');$('readinessBtn').onclick=()=>modal('Daily Readiness','TODAY',`<label class="field">Readiness <b id="rOut">${S.readiness}/10</b><input id="rF" type="range" min="1" max="10" value="${S.readiness}"></label><button id="rSave" class="primary">SAVE</button>`);$('modal').addEventListener('input',e=>{if(e.target.id==='rF')$('rOut').textContent=e.target.value+'/10'});$('modal').addEventListener('click',e=>{if(e.target.id==='rSave'){S.readiness=+$('rF').value;save();closeModal();toast('Readiness updated')}});$('prev').onclick=()=>setEx(S.ex-1);$('next').onclick=()=>setEx(S.ex+1);$('detailBtn').onclick=()=>detail(S.ex);$('startWorkout').onclick=startWorkout;$('workoutBack').onclick=()=>toast('Finish workout to save it');$('wPrev').onclick=()=>{setEx(S.ex-1);setDone=0;updateWorkout()};$('wNext').onclick=()=>{setEx(S.ex+1);setDone=0;updateWorkout()};$('completeSet').onclick=()=>{const e=EX[S.ex];if(setDone<e.sets){setDone++;updateWorkout();toast('Set completed')}else toast('All sets complete')};$('pause').onclick=()=>{paused=!paused;$('pause').textContent=paused?'Resume':'Pause'};$('finish').onclick=finishWorkout;$$('[data-nut]').forEach(b=>b.onclick=()=>{const k=b.dataset.nut,v=prompt('Enter '+k+' consumed today:',S.nut[k]);if(v!==null&&!isNaN(+v)){S.nut[k]=Math.max(0,+v);save()}});$('localMusic').onclick=()=>$('audioPick').click();$('audioPick').onchange=e=>{const f=e.target.files[0];if(f){$('audio').src=URL.createObjectURL(f);$('musicStatus').textContent=f.name;toast('Local music selected')}};$('ytMusic').onclick=()=>location.href='https://music.youtube.com/';$('spotify').onclick=()=>location.href='https://open.spotify.com/';$('autoPlay').onchange=e=>{S.autoPlay=e.target.checked;save()};$('autoStop').onchange=e=>{S.autoStop=e.target.checked;save()};buildWeek();render();
</script></body></html>
