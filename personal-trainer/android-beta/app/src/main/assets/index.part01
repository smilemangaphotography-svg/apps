translateX(-50%)}}
</style></head><body>
<section id="cover" class="cover"><div class="cover-copy"><h1>PERSONAL<br><span>TRAINER</span></h1><div class="tag">DISCIPLINE TODAY.<br>A STRONGER TOMORROW</div></div><button id="enter" class="enter">ENTER</button><button id="adminCover" class="admin-cover">⚙<small>Admin</small></button><div class="motto">TRAIN • FUEL • RECOVER • REPEAT</div></section>
<main id="shell" class="shell hidden"><header class="top"><button id="menuBtn" class="icon">☰</button><div class="brand">PERSONAL TRAINER</div></header><div id="scrim" class="scrim"></div><aside id="drawer" class="drawer"><div class="profile"><div class="avatar">PT</div><div><b id="drawerName">Your Name</b><div class="muted">View profile</div></div></div><div class="menu"><button data-open="home"><span>⌂</span>Home</button><button data-modal="goals"><span>◎</span>Goals</button><button data-modal="programs"><span>▣</span>Programs</button><button data-modal="injuries"><span>✚</span>Injuries</button><button data-open="nutrition"><span>♨</span>Nutrition</button><button data-modal="connected"><span>⌁</span>Connected Data</button><button data-open="music"><span>♫</span>Music Sources</button><button data-modal="progress"><span>↗</span>Progress</button><button data-modal="settings"><span>⚙</span>Settings</button><button data-modal="admin"><span>▣</span>Admin</button></div></aside>
<section class="page active" data-page="home"><div class="hero"><div class="hero-text"><div class="eyebrow">GOOD MORNING</div><h2 id="hello">Let's Train.</h2><p>Small steps today. Big results tomorrow.</p></div></div><div class="card readiness"><div class="ring" id="readyScore">8/10</div><div><b>Readiness</b><div id="readyText" style="color:var(--green);font-weight:900">Good to train</div><div class="muted">Tap to update today's readiness</div></div></div><button class="card" id="readinessBtn" style="width:100%;color:white;text-align:left"><span class="eyebrow">TODAY'S PLAN</span><div class="plan-grid" style="margin-top:8px"><div class="mini">🏋️ <strong>Lower Body Strength</strong><span class="muted">45 min</span></div><div class="mini">🏃 <strong>Recovery Run</strong><span class="muted">5 km • Zone 2</span></div><div class="mini">🧘 <strong>Mobility</strong><span class="muted">10 min</span></div><div class="mini">♥ <strong id="injuryFocus">Knee Capacity</strong><span class="muted">8 min</span></div></div></button><button id="startToday" class="primary">START TODAY</button><div class="card"><div class="row between"><div><span class="eyebrow">WEEKLY PROGRESS</span><div class="big" id="weekProgress">0/4</div><span class="muted">sessions completed</span></div><div style="width:45%"><div class="progressbar"><i id="weekBar" style="width:0%"></i></div></div></div></div></section>
<section class="page" data-page="train"><div class="eyebrow">THIS WEEK</div><h2 id="weekTitle">Training Week</h2><div id="week" class="week"></div><div class="tabs"><button class="pill active">TRAIN</button><button class="pill">RUNNING</button><button class="pill">RECOVERY</button></div><div class="card"><div class="row between"><div><span class="eyebrow" id="exCount">EXERCISE 1 OF 6</span><h2 id="exName" style="margin:4px 0">Goblet Squat</h2></div><button id="detailBtn" class="secondary">DETAIL</button></div><div id="motionStage" class="exercise-stage"><img class="motion-frame" id="frame1"><img class="motion-frame" id="frame2"><img class="motion-frame" id="frame3"><div id="motionNote" class="motion-note"></div></div><div class="stats"><div class="stat"><small>SETS</small><strong id="sets">3</strong></div><div class="stat"><small>REPS</small><strong id="reps">12</strong></div><div class="stat"><small>WEIGHT</small><strong id="weight">16</strong></div><div class="stat"><small>REST</small><strong id="rest">60s</strong></div></div><div class="controls" style="margin-top:10px"><button id="prev" class="secondary">Previous</button><button id="startWorkout" class="primary" style="margin:0">START</button><button id="next" class="secondary">Next</button></div></div></section>
<section class="page" data-page="exercises"><div class="eyebrow">MOVEMENT LIBRARY</div><h2>Exercises</h2><div id="filters" class="filters"></div><div id="exerciseList" class="list"></div></section>
<section class="page" data-page="music"><div class="eyebrow">WORKOUT AUDIO</div><h2>Music</h2><div class="card"><b id="musicStatus">No music selected</b><div class="muted">Choose local audio or launch an external service.</div></div><div class="source"><button id="localMusic">📁 <b>Local Storage</b><div class="muted">Choose audio from this device</div></button><input id="audioPick" class="hidden" type="file" accept="audio/*"><button id="ytMusic">▶️ <b>YouTube Music</b><div class="muted">Open YouTube Music</div></button><button id="spotify">🟢 <b>Spotify</b><div class="muted">Open Spotify</div></button></div><audio id="audio" controls style="width:100%;margin-top:12px"></audio><div class="card"><label class="tog"><span>Auto play with workout</span><input id="autoPlay" type="checkbox" checked></label><label class="tog"><span>Auto stop when workout ends</span><input id="autoStop" type="checkbox" checked></label></div></section>
<section class="page" data-page="nutrition"><div class="eyebrow">FUEL YOUR PERFORMANCE</div><h2>Nutrition</h2><div class="nut-grid"><button class="card nut" data-nut="calories"><span class="eyebrow">CALORIES</span><strong id="caloriesVal">0 / 2250</strong><span class="muted">kcal today</span></button><button class="card nut" data-nut="protein"><span class="eyebrow">PROTEIN</span><strong id="proteinVal">0 / 140</strong><span class="muted">grams</span></button><button class="card nut" data-nut="water"><span class="eyebrow">HYDRATION</span><strong id="waterVal">0 / 2500</strong><span class="muted">ml</span></button><button class="card nut" data-nut="creatine"><span class="eyebrow">CREATINE</span><strong id="creatineVal">0 / 5</strong><span class="muted">grams</span></button></div><button class="card" data-modal="food" style="width:100%;color:white;text-align:left"><b>Food Allergies & Restrictions</b><div class="muted" id="foodSummary">None set</div></button></section>
<nav class="bottom"><button data-nav="home" class="active">⌂<small>Home</small></button><button data-nav="train">♨<small>Train</small></button><button data-nav="exercises">◎<small>Exercises</small></button><button data-nav="music">♫<small>Music</small></button><button data-nav="nutrition">◫<small>Nutrition</small></button></nav></main>
<section id="modal" class="modal hidden"><div class="modal-head"><button id="modalBack" class="icon">‹</button><div><div class="eyebrow" id="modalEye">SETUP</div><b id="modalTitle">Settings</b></div></div><div id="modalBody"></div></section>
<section id="workout" class="workout-overlay hidden"><div class="row between"><button id="workoutBack" class="icon">‹</button><b>Workout Active</b><span></span></div><div class="timer-ring"><div><strong id="timer">00:00</strong><div class="muted" id="setText">Set 1 of 3</div></div></div><div id="workoutImages" class="workout-image"><img class="motion-frame" id="wf1"><img class="motion-frame" id="wf2"><img class="motion-frame" id="wf3"></div><h2 id="workoutName" style="text-align:center">Goblet Squat</h2><div class="stats"><div class="stat"><small>REPS</small><strong id="wReps">12</strong></div><div class="stat"><small>WEIGHT</small><strong id="wWeight">16kg</strong></div><div class="stat"><small>REST</small><strong id="wRest">60s</strong></div><div class="stat"><small>DONE</small><strong id="wDone">0/3</strong></div></div><button id="completeSet" class="primary">COMPLETE SET</button><div class="controls" style="margin-top:9px"><button id="wPrev" class="secondary">Previous</button><button id="pause" class="secondary">Pause</button><button id="wNext" class="secondary">Next</button></div><button id="finish" class="primary danger">FINISH WORKOUT</button></section><div id="toast" class="toast"></div>
<script>
const KEY='pt.android.beta.12';const defaults={name:'',goal:'10K',target:'48:00',weeks:12,days:4,injury:'Knee',pain:0,side:'Left',notes:'',allergies:'',foodAvoid:'',readiness:8,workouts:[],nut:{calories:0,protein:0,water:0,creatine:0},autoPlay:true,autoStop:true,ex:0,filter:'All',adminPin:'1234'};let S=Object.assign({},defaults,JSON.parse(localStorage.getItem(KEY)||'{}'));S.nut=Object.assign({},defaults.nut,S.nut||{});const $=id=>document.getElementById(id), $$=s=>[...document.querySelectorAll(s)];function save(){localStorage.setItem(KEY,JSON.stringify(S));render()}function toast(t){$('toast').textContent=t;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1600)}
const EX=[{n:'Goblet Squat',cat:'Lower',slug:'heel-elevated-goblet-squat',sets:3,reps:12,kg:16,rest:60,m:'Quads • glutes • core'},{n:'45° Leg Press',cat:'Lower',slug:'leg-press',sets:3,reps:12,kg:70,rest:90,m:'Quads • glutes • ha