een)}.toast{position:fixed;z-index:200;left:50%;bottom:94px;transform:translateX(-50%);background:#fff;color:#111;padding:10px 14px;border-radius:22px;font-size:12px;font-weight:850;display:none;white-space:nowrap}.toast.show{display:block}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.metric-card{padding:13px;border:1px solid #2a373e;background:#11191d;border-radius:12px}.metric-card b{font-size:20px;display:block;margin-top:5px}.qa{font-family:monospace;white-space:pre-wrap;background:#07100b;color:#a8ffbd;padding:12px;font-size:11px}.safe-space{height:4px}@media(max-width:380px){.cover h1{font-size:41px}.plan-grid{grid-template-columns:1fr}.hero{height:205px}.brand{font-size:16px}.stats{grid-template-columns:repeat(2,1fr)}}
</style></head><body>
<section id="cover" class="cover"><div class="cover-copy"><h1>PERSONAL<br><span>TRAINER</span></h1><div class="tag">DISCIPLINE TODAY.<br>A STRONGER TOMORROW</div></div><button id="enter" class="enter">ENTER</button><button id="adminCover" class="admin-cover" aria-label="Admin">⚙<small>Admin</small></button><div class="motto">TRAIN • FUEL • RECOVER • REPEAT</div></section>
<main id="shell" class="shell hidden"><header class="top"><button id="menuBtn" class="icon" aria-label="Menu">☰</button><div class="brand">PERSONAL TRAINER</div></header><div id="scrim" class="scrim"></div><aside id="drawer" class="drawer"><div class="profile"><div class="avatar">PT</div><div><b id="drawerName">Your Name</b><div class="muted">Training profile</div></div></div><div class="menu"><button data-open="home"><span>⌂</span>Home</button><button data-modal="goals"><span>◎</span>Goals</button><button data-modal="programs"><span>▣</span>Programs</button><button data-modal="injuries"><span>✚</span>Injuries</button><button data-open="nutrition"><span>◫</span>Nutrition</button><button data-modal="connected"><span>⌁</span>Connected Data</button><button data-open="music"><span>♫</span>Music Sources</button><button data-modal="progress"><span>↗</span>Progress</button><button data-modal="settings"><span>⚙</span>Settings</button><button data-modal="admin"><span>◆</span>Admin</button></div></aside>
<section class="page active" data-page="home"><div class="hero"><div class="hero-text"><div class="eyebrow" id="greetingEye">GOOD MORNING</div><h2 id="hello">Let's Train.</h2><p>Small steps today. Big results tomorrow.</p></div></div><button class="card readiness" id="readinessBtn"><div class="ring" id="readyScore">8/10</div><div><b>Readiness</b><div id="readyText" style="color:var(--green);font-weight:900">Good to train</div><div class="muted" id="readyReason">Tap to update today's readiness</div></div></button><div class="card"><span class="eyebrow">TODAY'S PLAN</span><div class="plan-grid"><div class="mini"><div class="glyph">◆</div><strong id="planStrength">Lower Body Strength</strong><span class="muted">45 min</span></div><div class="mini"><div class="glyph">↗</div><strong id="planRun">Recovery Run</strong><span class="muted">5 km • Zone 2</span></div><div class="mini"><div class="glyph">◌</div><strong>Mobility</strong><span class="muted">10 min</span></div><div class="mini"><div class="glyph">♥</div><strong id="injuryFocus">Knee Capacity</strong><span class="muted">8 min</span></div></div></div><button id="startToday" class="primary">START TODAY</button><div class="card"><div class="row between"><div><span class="eyebrow">WEEKLY PROGRESS</span><div class="big" id="weekProgress">0/4</div><span class="muted">sessions completed</span></div><div style="width:45%"><div class="progressbar"><i id="weekBar" style="width:0%"></i></div></div></div></div></section>
<section class="page" data-page="train"><div class="eyebrow">THIS WEEK</div><h2 style="margin:6px 0 14px">Training Week</h2><div id="week" class="week"></div><div id="sessionTabs" class="tabs"><button class="pill active" data-session="TRAIN">TRAIN</button><button class="pill" data-session="RUNNING">RUNNING</button><button class="pill" data-session="RECOVERY">RECOVERY</button></div><div class="card session-summary"><span class="eyebrow" id="sessionEye">STRENGTH SESSION</span><h3 id="sessionName">Lower Body Strength</h3><div class="muted" id="sessionMeta">45 min • Gym</div></div><div class="card" id="exerciseCard"><div class="row between"><div><span class="eyebrow" id="exCount">EXERCISE 1 OF 6</span><h2 id="exName" style="margin:4px 0">Goblet Squat</h2></div><button id="detailBtn" class="secondary">DETAIL</button></div><div id="motionStage" class="exercise-stage"><div class="media-badge" id="mediaBadge">ANATOMY REFERENCE</div><img class="anatomy" id="exerciseMedia" alt="Exercise anatomy"><div id="mediaFallback" class="media-fallback hidden"><div class="lock">◇</div><b>Motion asset under review</b><span class="muted">No unverified anatomy is shown.</span></div><div id="motionNote" class="motion-note"></div></div><div class="stats"><div class="stat"><small>SETS</small><strong id="sets">3</strong></div><div class="stat"><small>REPS</small><strong id="reps">12</strong></div><div class="stat"><small>WEIGHT</small><strong id="weight">16</strong></div><div class="stat"><small>REST</small><strong id="rest">60s</strong></div></div><div class="controls" style="margin-top:10px"><button id="prev" class="secondary">‹ Previous</button><button id="startWorkout" class="primary" style="margin:0">START</button><button id="next" class="secondary">Next ›</button></div></div><div id="nonExerciseSession" class="card hidden"></div></section>
<section class="page" data-page="exercises"><div class="eyebrow">MOVEMENT LIBRARY</div><h2>Exercises</h2><div id="filters" class="filters"></div><div id="exerciseList" class="list"></div></section>
<section class="page" data-page="music"><div class="eyebrow">WORKOUT AUDIO</div><h2>Music</h2><div class="card"><b id="musicStatus">No music selected</b><div class="muted">Choose local audio or launch your music service.</div></div><div class="source"><button id="localMusic">▣ <b>Local Storage</b><div class="muted">Choose audio from this device</div></button><input id="audioPick" class="hidden" type="file" accept="audio/*"><button id="ytMusic">▶ <b>YouTube Music</b><div class="muted">Open YouTube Music</div></button><button id="spotify">● <b>Spotify</b><div class="muted">Open Spotify</div></button></div><audio id="audio" controls style="width:100%;margin-top:12px"></audio><div class="card"><label class="tog"><span>Auto play with workout</span><input id="autoPlay" type="checkbox" checked></label><label class="tog"><span>Continue during rest</span><input id="musicDuringRest" type="checkbox" checked></label><label class="tog"><span>Auto stop when workout ends</span><input id="autoStop" type="checkbox" checked></label></div></section>
<section class="page" data-page="nutrition"><div class="eyebrow">FUEL YOUR PERFORMANCE</div><h2>Nutrition</h2><div class="nut-grid"><button class="card nut" data-nut="calories"><span class="eyebrow">CALORIES</span><strong id="caloriesVal">0 / 2250</strong><span class="muted">kcal today</span></button><button class="card nut" data-nut="protein"><span class="eyebrow">PROTEIN</span><strong id="proteinVal">0 / 140</strong><span class="muted">grams</span></button><button class="card nut" data-nut="water"><span class="eyebrow">HYDRATION</span><strong id="waterVal">0 / 2500</strong><span class="muted">ml</span></button><button class="card nut" data-nut="creatine"><span class="eyebrow">CREATINE</span><strong id="creatineVal">0 / 5</strong><span class="muted">grams</span></button></div><button class="card" data-modal="food" style="width:100%;color:white;text-align:left"><b>Food Allergies & Restrictions</b><div class="muted" id="foodSummary">None set</div></button></section>
<nav class="bottom"><button data-nav="home" class="active">⌂<small>Home</small></button><button data-nav="train">♨<small>Train</small></button><button data-nav="exercises">◎<small>Exercises</small></button><button data-nav="music">♫<small>Music</small></button><button data-nav="nutrition">◫<small>Nutrition</small></button></nav></main>
<section id="modal" class="modal hidden"><div class="modal-head"><button id="modalBack" class="icon">‹</button><div><div class="eyebrow" id="modalEye">SETUP</div><b id="modalTitle">Settings</b></div></div><div id="modalBody"></div></section>
<section id="workout" class="workout-overlay hidden"><div class="row between"><button id="workoutBack" class="icon">‹</button><b>Workout Active</b><span></span></div><div id="timerRing" class="timer-ring"><div><strong id="timer">00:00</strong><div class="muted" id="setText">Set 1 of 3</div></div></div><div id="workoutImages" class="workout-image"><img id="workoutMedia" alt="Workout anatomy"><div id="workoutFallback" class="media-fallback hidden"><div class="lock">◇</div><b>Motion asset under review</b></div></div><h2 id="workoutName" style="text-align:center">Goblet Squat</h2><div class="stats"><div class="stat"><small>REPS</small><strong id="wReps">12</strong></div><div class="stat"><small>WEIGHT</small><strong id="wWeight">16kg</strong></div><div class="stat"><small>REST</small><strong id="wRest">60s</strong></div><div class="stat"><small>DONE</small><strong id="wDone">0/3</strong></div></div><button id="completeSet" class="primary">COMPLETE SET</button><div class="controls" style="margin-top:9px"><button id="wPrev" class="secondary">‹ Previous</button><button id="pause" class="secondary">Pause</button><button id="wNext" class="secondary">Next ›</button></div><button id="finish" class="primary danger">FINISH WORKOUT</button></section><div id="toast" class="toast"></div><pre id="qa" class="qa hidden"></pre>
<script>
const MEDIA={goblet:'media/goblet.webp',legpress:'media/legpress.webp'};
const KEY='pt.android.beta.13';
const defaults={name:'',goal:'10K',target:'48:00',targetDate:'',weeks:12,days:4,injury:'Knee',pain:0,side:'Left',notes:'',allergies:'',intolerances:'',foodAvoid:'',readiness:{sleep:8,energy:8,soreness:8,motivation:8,pain:8},workouts:[],nut:{calories:0,pro